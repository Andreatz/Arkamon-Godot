; Arkamon: first playable native 2D slice.
config_version=5

[application]
config/name="Arkamon — Il primo viaggio"
config/description="Una prima avventura 2D di Arkamon per PC."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icon.svg"
config/version="0.1.0"

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=800
window/size/min_width=1000
window/size/min_height=625
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.025, 0.047, 0.075, 1)

[audio]
default_bus_layout=""
